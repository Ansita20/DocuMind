# Required for chat. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# DATA_DIR=./data
# MAX_UPLOAD_MB=50
# CHUNK_CHARS=1400
# CHUNK_OVERLAP=250
# RETRIEVAL_TOP_K=10
# INGEST_CONCURRENCY=2
# CORS_ORIGINS=http://localhost:5173

# Vercel only: connecting a Blob store to the project sets these automatically.
# Leave unset locally to store files on disk under DATA_DIR.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
